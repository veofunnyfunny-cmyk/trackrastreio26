# Copie este arquivo para ".env" e ajuste conforme necessário.

# Porta do servidor
PORT=3000

# Segredo dos cookies de sessão (troque por algo aleatório em produção)
SESSION_SECRET=troque-esse-segredo

# URL base do sistema (opcional). Em produção coloque o domínio real,
# ex.: https://rastreio.suaempresa.com  — usado para montar o link de rastreio.
# BASE_URL=https://rastreio.suaempresa.com

# Evolution API (motor de WhatsApp com QR code). Configure uma vez.
# Local (Docker):  http://localhost:8080
# Produção:        a URL do seu servidor Evolution
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=

# Gateway de pagamento Pix (Roundfy) — chave em Credenciais de API
ROUNDFY_API_KEY=
# ROUNDFY_URL=https://roundfy-api-abacate.vercel.app

# SMS (SMSDev) — canal opcional, pré-pago. Chave em smsdev.com.br
SMS_API_KEY=
