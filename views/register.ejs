<%- include('partials/head', { title: 'Criar conta - Rastreio' }) %>
<div class="center-wrap">
  <div class="center-card card">
    <h1>📦 Rastreio</h1>
    <p class="sub">Crie sua conta de cliente</p>
    <% if (erro) { %><div class="alert err"><%= erro %></div><% } %>
    <form method="post" action="/register">
      <label>Nome / Loja</label>
      <input type="text" name="name" value="<%= dados.name || '' %>" required autofocus>
      <label>E-mail</label>
      <input type="email" name="email" value="<%= dados.email || '' %>" required>
      <label>Senha (mín. 6 caracteres)</label>
      <input type="password" name="password" required>
      <button type="submit" style="width:100%; margin-top:18px">Criar conta</button>
    </form>
    <p class="muted-link">Já tem conta? <a href="/login">Entrar</a></p>
  </div>
</div>
</body></html>
