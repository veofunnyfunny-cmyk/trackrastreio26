<%- include('partials/head', { title: 'Configurações - Rastreio' }) %>
<%- include('partials/shell', { active: 'config' }) %>

<div class="topbar"><div><h1>Configurações de envio</h1><p class="sub">Escolha como as mensagens são entregues.</p></div></div>

<% if (salvo) { %><div class="alert ok">Configurações salvas!</div><% } %>
<% if (typeof erro !== 'undefined' && erro) { %><div class="alert err"><%= erro %></div><% } %>

<!-- ================= LOGO DA LOJA (upload próprio) ================= -->
<div class="card">
  <h2 style="margin-top:0">🖼️ Logo da loja</h2>
  <p class="hint" style="margin-top:0">Aparece no topo da página de rastreio que o seu cliente vê — dá mais confiança pra ele saber de onde é a compra.</p>
  <% if (user.logo_file) { %>
    <div style="margin:14px 0; padding:14px; background:var(--surface-2); border:1px solid var(--border); border-radius:10px; display:inline-block">
      <img src="/loja-logo/<%= user.id %>?v=<%= Date.now() %>" alt="Logo" style="max-height:70px; max-width:200px; display:block">
    </div>
    <form method="post" action="/config/logo/remover" style="margin:0 0 6px" onsubmit="return confirm('Remover a logo?')">
      <button class="btn-ghost btn-sm">Remover logo</button>
    </form>
  <% } %>
  <form method="post" action="/config/logo" enctype="multipart/form-data" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:8px">
    <input type="file" name="logo" accept="image/*" required style="flex:1; min-width:200px">
    <button>Enviar logo</button>
  </form>
  <p class="hint">Formatos: PNG, JPG, WEBP. Máx. 3 MB. Recomendado: fundo transparente (PNG).</p>
</div>

<form method="post" action="/config">
  <!-- ================= LOJA ================= -->
  <div class="card">
    <h2 style="margin-top:0">🏪 Sua loja</h2>
    <label>Nome da loja</label>
    <input type="text" name="store_name" value="<%= user.store_name %>" placeholder="Ex.: Loja do João" oninput="detectarEmail()">
    <p class="hint">Esse nome aparece no topo da página de rastreio que o seu cliente vê, e na variável <code>{loja}</code> das mensagens.</p>
  </div>

  <!-- ================= CANAIS DE ENVIO ================= -->
  <div class="card">
    <h2 style="margin-top:0">📨 Canais de envio</h2>
    <p class="hint" style="margin-top:0">Escolha por onde as mensagens de rastreio são enviadas. Você só é cobrado pelos canais que estiverem ligados e enviarem.</p>
    <label style="display:flex; align-items:center; gap:10px; margin:14px 0 0; cursor:pointer">
      <input type="checkbox" name="notify_whatsapp" value="1" style="width:auto" <%= user.notify_whatsapp ? 'checked' : '' %>>
      <span>💬 <b>WhatsApp</b> — <%= billing.formatBRL(billing.PRECOS.whatsapp) %> por mensagem</span>
    </label>
    <label style="display:flex; align-items:center; gap:10px; margin:12px 0 0; cursor:pointer">
      <input type="checkbox" name="notify_email" value="1" style="width:auto" <%= user.notify_email ? 'checked' : '' %>>
      <span>✉️ <b>E-mail</b> — <%= billing.formatBRL(billing.PRECOS.email) %> por mensagem</span>
    </label>
    <label style="display:flex; align-items:center; gap:10px; margin:12px 0 0; cursor:<%= smsAtivo ? 'pointer' : 'not-allowed' %>; opacity:<%= smsAtivo ? '1' : '.55' %>">
      <input type="checkbox" name="notify_sms" value="1" style="width:auto" <%= user.notify_sms ? 'checked' : '' %> <%= smsAtivo ? '' : 'disabled' %>>
      <span>📱 <b>SMS</b> — <%= billing.formatBRL(billing.PRECOS.sms) %> por mensagem <% if (!smsAtivo) { %><span class="sub">(indisponível no momento)</span><% } %></span>
    </label>
  </div>

  <!-- ================= AVISOS AUTOMÁTICOS ================= -->
  <div class="card">
    <h2 style="margin-top:0">🔔 Avisos automáticos de atualização</h2>
    <p class="hint" style="margin-top:0">Com isso ligado, o sistema avisa o cliente <b>sozinho</b> a cada nova etapa do pedido (saiu de SP, a caminho, saiu para entrega...). Ele fica informado sem precisar clicar no link toda hora — <b>reduz muito reembolso/MED</b>.</p>
    <label style="display:flex; align-items:center; gap:10px; margin:14px 0 0; cursor:pointer">
      <input type="checkbox" name="auto_updates" value="1" style="width:auto" <%= user.auto_updates ? 'checked' : '' %>>
      <span><b>Ligar avisos automáticos</b></span>
    </label>
    <p class="hint">⚠️ Cada aviso é cobrado como uma mensagem normal (pelos canais ligados acima). Você controla o custo ligando/desligando aqui. A mensagem de aviso é editável na aba <a href="/mensagens">Mensagens</a>.</p>
  </div>

  <div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap">
    <div>
      <h2 style="margin:0">💬 WhatsApp</h2>
      <p class="sub" style="font-size:13.5px; margin-top:4px">O WhatsApp é conectado por QR code na aba dedicada.</p>
    </div>
    <a href="/whatsapp" class="btn">Conectar WhatsApp</a>
  </div>

  <!-- ================= EMAIL ================= -->
  <% if (emailCentral) { %>
  <div class="card">
    <h2 style="margin-top:0">✉️ E-mail</h2>
    <div class="alert ok" style="margin-bottom:0">
      ✅ O envio de e-mail já está ativo pelo sistema. Os e-mails saem com o <b>nome da sua loja</b> como remetente — você não precisa configurar nada aqui.
    </div>
  </div>
  <% } else { %>
  <div class="card">
    <h2 style="margin-top:0">✉️ E-mail (opcional)</h2>
    <p class="hint" style="margin-top:0">Preencha se quiser que os e-mails de rastreio saiam com o e-mail e o nome da sua loja. É só o e-mail e a senha — o resto o sistema descobre sozinho.</p>

    <div class="row">
      <div>
        <label>Seu e-mail de envio</label>
        <input type="email" name="smtp_email" id="smtp_email" value="<%= user.smtp_user %>" placeholder="sualoja@gmail.com" oninput="detectarEmail()">
      </div>
      <div>
        <label>Senha</label>
        <input type="password" name="smtp_pass" placeholder="<%= user.smtp_pass ? '•••••• (já salva)' : 'senha do e-mail' %>">
      </div>
    </div>

    <div id="email-help" class="alert info" style="display:none; margin-top:12px"></div>

    <p class="hint">O remetente vai aparecer como <b><span id="from-preview"><%= user.store_name %></span> &lt;seu-email&gt;</b>.</p>

    <details style="margin-top:8px">
      <summary class="hint" style="cursor:pointer">Meu provedor não foi reconhecido (configurar manualmente)</summary>
      <div class="row" style="margin-top:10px">
        <div><label>Host SMTP</label><input name="smtp_host_manual" value="<%= user.smtp_host %>" placeholder="smtp.seuprovedor.com"></div>
        <div><label>Porta</label><input name="smtp_port_manual" value="<%= user.smtp_port %>" placeholder="587"></div>
      </div>
    </details>
  </div>
  <% } %>

  <button>Salvar configurações</button>
</form>

<script>
  // ---- Detecção automática do provedor de e-mail ----
  var SMTP_PROVIDERS = {
    'gmail.com': { nome: 'Gmail', appPass: true },
    'googlemail.com': { nome: 'Gmail', appPass: true },
    'outlook.com': { nome: 'Outlook', appPass: false },
    'hotmail.com': { nome: 'Outlook', appPass: false },
    'live.com': { nome: 'Outlook', appPass: false },
    'yahoo.com': { nome: 'Yahoo', appPass: true },
    'yahoo.com.br': { nome: 'Yahoo', appPass: true },
    'icloud.com': { nome: 'iCloud', appPass: true },
    'zoho.com': { nome: 'Zoho', appPass: false },
    'uol.com.br': { nome: 'UOL', appPass: false },
    'bol.com.br': { nome: 'BOL', appPass: false },
  };
  function detectarEmail() {
    var emailInput = document.getElementById('smtp_email');
    if (!emailInput) return; // seção de e-mail escondida (modo conta central)
    var email = (emailInput.value || '').trim();
    var dom = (email.split('@')[1] || '').toLowerCase();
    var box = document.getElementById('email-help');
    var storeInput = document.querySelector('[name=store_name]');
    document.getElementById('from-preview').textContent = (storeInput && storeInput.value.trim()) || 'Minha Loja';
    if (!dom) { box.style.display = 'none'; return; }
    var p = SMTP_PROVIDERS[dom];
    box.style.display = 'block';
    if (p) {
      var msg = '✅ <b>' + p.nome + '</b> reconhecido — o servidor é configurado automaticamente.';
      if (p.appPass) {
        msg += '<br>⚠️ Este provedor exige uma <b>senha de app</b> (não a senha normal da conta).';
        if (p.nome === 'Gmail') msg += ' Gere em: Conta Google › Segurança › Verificação em duas etapas › Senhas de app.';
      }
      box.innerHTML = msg;
    } else {
      box.innerHTML = '❔ Provedor não reconhecido. Abra "configurar manualmente" abaixo e informe o servidor SMTP.';
    }
  }
  detectarEmail();
</script>

<%- include('partials/shell_end') %>
