<%- include('partials/head', { title: 'Configurações - Rastreio' }) %>
<%- include('partials/shell', { active: 'config' }) %>

<div class="topbar"><div><h1>Configurações de envio</h1><p class="sub">Escolha como as mensagens são entregues.</p></div></div>

<% if (salvo) { %><div class="alert ok">Configurações salvas!</div><% } %>

<form method="post" action="/config">
  <!-- ================= LOJA ================= -->
  <div class="card">
    <h2 style="margin-top:0">🏪 Sua loja</h2>
    <label>Nome da loja</label>
    <input type="text" name="store_name" value="<%= user.store_name %>" placeholder="Ex.: Loja do João" oninput="detectarEmail()">
    <p class="hint">Esse nome aparece no topo da página de rastreio que o seu cliente vê, e na variável <code>{loja}</code> das mensagens.</p>
  </div>

  <!-- ================= WHATSAPP ================= -->
  <div class="card">
    <h2 style="margin-top:0">💬 Conectar o WhatsApp</h2>

    <div class="alert info">
      <b>Como conectar (leva 2 minutos):</b>
      <ol style="margin:10px 0 0; padding-left:18px; line-height:1.9">
        <li>Crie uma conta no <a href="https://www.z-api.io" target="_blank">Z-API</a> e crie uma <b>instância</b>.</li>
        <li>No painel do Z-API, leia o <b>QR Code</b> com seu WhatsApp (Aparelhos conectados → Conectar aparelho).</li>
        <li>Ainda no Z-API, copie os dados <b>ID da Instância</b>, <b>Token</b> e <b>Token de Segurança</b> e cole abaixo.</li>
        <li>Clique em <b>Salvar</b> e depois em <b>Testar conexão</b>.</li>
      </ol>
    </div>

    <label>Provedor</label>
    <select name="wa_provider" id="wa_provider" onchange="toggleProvider()">
      <option value="z-api"    <%= (user.wa_provider==='z-api' || !user.wa_provider) ? 'selected' : '' %>>Z-API (recomendado)</option>
      <option value="evolution"<%= user.wa_provider==='evolution' ? 'selected' : '' %>>Evolution API</option>
      <option value=""         <%= user.wa_provider==='' && user.wa_api_url ? 'selected' : '' %>>Outro (genérico)</option>
    </select>

    <!-- URL base: só aparece para Evolution/Outro. Para Z-API é automática. -->
    <div id="wa_url_row" style="display:none">
      <label>URL base da API</label>
      <input name="wa_api_url" id="wa_api_url" value="<%= user.wa_api_url %>" placeholder="https://seu-servidor-evolution.com">
    </div>

    <div class="row">
      <div>
        <label>ID da Instância</label>
        <input name="wa_instance" value="<%= user.wa_instance %>" placeholder="ex.: 3D8B1F...">
        <p class="hint">No Z-API: dentro da sua instância, campo <b>ID da instância</b>.</p>
      </div>
      <div>
        <label>Token</label>
        <input name="wa_api_token" value="<%= user.wa_api_token %>" placeholder="token da instância">
        <p class="hint">No Z-API: campo <b>Token</b> da instância.</p>
      </div>
    </div>

    <label>Token de Segurança (Client-Token)</label>
    <input name="wa_client_token" value="<%= user.wa_client_token || '' %>" placeholder="cole aqui (Z-API › Segurança › Account Security Token)">
    <p class="hint">No Z-API fica em <b>Segurança da conta</b>. Se sua conta não usa, pode deixar em branco.</p>

    <div style="margin-top:14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
      <button type="button" class="btn-ghost" onclick="testarWhatsapp(this)">Testar conexão</button>
      <span id="wa_test_result" class="hint" style="margin:0"></span>
    </div>
    <p class="hint">Salve as configurações antes de testar.</p>
  </div>

  <!-- ================= EMAIL ================= -->
  <% if (emailCentral) { %>
  <div class="card">
    <h2 style="margin-top:0">✉️ E-mail</h2>
    <div class="alert ok" style="margin-bottom:0">
      ✅ O envio de e-mail já está ativo pelo sistema. Os e-mails saem com o <b>nome da sua loja</b> como remetente — você não precisa configurar nada aqui.
    </div>
  </div>
  <% } else { %>
  <div class="card">
    <h2 style="margin-top:0">✉️ E-mail (opcional)</h2>
    <p class="hint" style="margin-top:0">Preencha se quiser que os e-mails de rastreio saiam com o e-mail e o nome da sua loja. É só o e-mail e a senha — o resto o sistema descobre sozinho.</p>

    <div class="row">
      <div>
        <label>Seu e-mail de envio</label>
        <input type="email" name="smtp_email" id="smtp_email" value="<%= user.smtp_user %>" placeholder="sualoja@gmail.com" oninput="detectarEmail()">
      </div>
      <div>
        <label>Senha</label>
        <input type="password" name="smtp_pass" placeholder="<%= user.smtp_pass ? '•••••• (já salva)' : 'senha do e-mail' %>">
      </div>
    </div>

    <div id="email-help" class="alert info" style="display:none; margin-top:12px"></div>

    <p class="hint">O remetente vai aparecer como <b><span id="from-preview"><%= user.store_name %></span> &lt;seu-email&gt;</b>.</p>

    <details style="margin-top:8px">
      <summary class="hint" style="cursor:pointer">Meu provedor não foi reconhecido (configurar manualmente)</summary>
      <div class="row" style="margin-top:10px">
        <div><label>Host SMTP</label><input name="smtp_host_manual" value="<%= user.smtp_host %>" placeholder="smtp.seuprovedor.com"></div>
        <div><label>Porta</label><input name="smtp_port_manual" value="<%= user.smtp_port %>" placeholder="587"></div>
      </div>
    </details>
  </div>
  <% } %>

  <button>Salvar configurações</button>
</form>

<script>
  function toggleProvider() {
    var p = document.getElementById('wa_provider').value;
    // Para Z-API a URL é fixa (api.z-api.io), então escondemos o campo.
    document.getElementById('wa_url_row').style.display = (p === 'z-api') ? 'none' : 'block';
  }
  toggleProvider();

  // ---- Detecção automática do provedor de e-mail ----
  var SMTP_PROVIDERS = {
    'gmail.com': { nome: 'Gmail', appPass: true },
    'googlemail.com': { nome: 'Gmail', appPass: true },
    'outlook.com': { nome: 'Outlook', appPass: false },
    'hotmail.com': { nome: 'Outlook', appPass: false },
    'live.com': { nome: 'Outlook', appPass: false },
    'yahoo.com': { nome: 'Yahoo', appPass: true },
    'yahoo.com.br': { nome: 'Yahoo', appPass: true },
    'icloud.com': { nome: 'iCloud', appPass: true },
    'zoho.com': { nome: 'Zoho', appPass: false },
    'uol.com.br': { nome: 'UOL', appPass: false },
    'bol.com.br': { nome: 'BOL', appPass: false },
  };
  function detectarEmail() {
    var emailInput = document.getElementById('smtp_email');
    if (!emailInput) return; // seção de e-mail escondida (modo conta central)
    var email = (emailInput.value || '').trim();
    var dom = (email.split('@')[1] || '').toLowerCase();
    var box = document.getElementById('email-help');
    var storeInput = document.querySelector('[name=store_name]');
    document.getElementById('from-preview').textContent = (storeInput && storeInput.value.trim()) || 'Minha Loja';
    if (!dom) { box.style.display = 'none'; return; }
    var p = SMTP_PROVIDERS[dom];
    box.style.display = 'block';
    if (p) {
      var msg = '✅ <b>' + p.nome + '</b> reconhecido — o servidor é configurado automaticamente.';
      if (p.appPass) {
        msg += '<br>⚠️ Este provedor exige uma <b>senha de app</b> (não a senha normal da conta).';
        if (p.nome === 'Gmail') msg += ' Gere em: Conta Google › Segurança › Verificação em duas etapas › Senhas de app.';
      }
      box.innerHTML = msg;
    } else {
      box.innerHTML = '❔ Provedor não reconhecido. Abra "configurar manualmente" abaixo e informe o servidor SMTP.';
    }
  }
  detectarEmail();

  async function testarWhatsapp(btn) {
    var out = document.getElementById('wa_test_result');
    out.style.color = 'var(--muted)';
    out.textContent = 'Testando...';
    btn.disabled = true;
    try {
      var resp = await fetch('/config/testar-whatsapp', { method: 'POST' });
      var data = await resp.json();
      out.style.color = data.ok && data.connected ? 'var(--success)' : (data.ok ? 'var(--warn)' : 'var(--danger)');
      out.textContent = data.message || (data.ok ? 'OK' : 'Falhou');
    } catch (e) {
      out.style.color = 'var(--danger)';
      out.textContent = 'Erro ao testar: ' + e.message;
    } finally {
      btn.disabled = false;
    }
  }
</script>

<%- include('partials/shell_end') %>
