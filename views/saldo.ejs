<%- include('partials/head', { title: 'Saldo - Rastreio' }) %>
<%- include('partials/shell', { active: 'saldo' }) %>

<div class="topbar"><div><h1>Saldo & Recarga</h1><p class="sub">Adicione saldo para enviar mensagens.</p></div></div>

<% if (salvo) { %><div class="alert ok">Saldo adicionado!</div><% } %>
<% if (typeof erro !== 'undefined' && erro) { %><div class="alert err"><%= erro %></div><% } %>

<div class="grid cols-2">
  <div class="card">
    <div class="sub">Saldo disponível</div>
    <div style="font-size:38px; font-weight:700; color:var(--success); margin:4px 0; letter-spacing:-.02em"><%= saldoBRL %></div>
    <div class="sub" style="font-size:13px">
      💬 WhatsApp: <%= billing.formatBRL(billing.PRECOS.whatsapp) %>/msg &nbsp;•&nbsp;
      ✉️ E-mail: <%= billing.formatBRL(billing.PRECOS.email) %>/msg
    </div>
  </div>

  <div class="card">
    <h2 style="margin-top:0">Adicionar saldo via Pix</h2>
    <% if (pixConfigured) { %>
      <form method="post" action="/saldo/pix/criar">
        <label>Valor da recarga (R$)</label>
        <input type="number" name="valor" value="30" min="30" step="1" required>
        <div style="display:flex; gap:8px; margin:10px 0 4px; flex-wrap:wrap">
          <% [30, 50, 100, 200].forEach(v => { %>
            <button type="button" class="btn-ghost btn-sm" onclick="document.querySelector('[name=valor]').value=<%= v %>">R$ <%= v %></button>
          <% }) %>
        </div>
        <label>CPF do pagador</label>
        <input type="text" name="cpf" placeholder="Somente números" maxlength="14" required>
        <button style="width:100%; margin-top:16px">Gerar Pix</button>
        <p class="hint">Valor mínimo R$ 30,00. Você recebe um QR code para pagar.</p>
      </form>
    <% } else { %>
      <p class="sub">A recarga por Pix ainda não está configurada neste ambiente.</p>
    <% } %>

    <% if (testTopup) { %>
      <hr style="border:none; border-top:1px solid var(--border); margin:18px 0">
      <details>
        <summary class="sub" style="cursor:pointer">Recarga de teste (fictícia)</summary>
        <form method="post" action="/saldo/recarga-teste" style="display:flex; gap:10px; align-items:flex-end; margin-top:10px">
          <div style="flex:1"><input type="number" name="valor" value="10" min="1" max="1000" step="1"></div>
          <button class="btn-ghost">Adicionar (teste)</button>
        </form>
      </details>
    <% } %>
  </div>
</div>

<h2>Extrato</h2>
<div class="card">
  <% if (transacoes.length === 0) { %>
    <p class="sub">Nenhuma movimentação ainda.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Quando</th><th>Descrição</th><th style="text-align:right">Valor</th></tr></thead>
      <tbody>
        <% transacoes.forEach(t => { %>
          <tr>
            <td class="sub" style="font-size:12px"><%= t.created_at %></td>
            <td><%= t.description %><% if (t.channel) { %> <span class="sub">(<%= t.channel %>)</span><% } %></td>
            <td style="text-align:right" class="<%= t.kind==='credito' ? 'money-in' : 'money-out' %>">
              <%= t.kind==='credito' ? '+' : '−' %> <%= billing.formatBRL(t.amount_cents) %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/shell_end') %>
