<%# Barra lateral do painel. `active` define o item destacado. %>
<div class="shell">
  <aside class="sidebar">
    <div class="brand">
      <span class="logo-mark">📦</span>
      <span>Rastreio<small><%= user.store_name %></small></span>
    </div>
    <div class="saldo-box">
      <span class="saldo-lbl">Saldo</span>
      <a href="/saldo" class="saldo-val"><%= typeof saldoBRL !== 'undefined' ? saldoBRL : 'R$ 0,00' %></a>
    </div>
    <nav class="nav">
      <a href="/"          class="<%= active==='dashboard' ? 'active' : '' %>">Painel</a>
      <a href="/saldo"     class="<%= active==='saldo'     ? 'active' : '' %>">Saldo & Recarga</a>
      <a href="/webhook"   class="<%= active==='webhook'   ? 'active' : '' %>">Webhook</a>
      <a href="/whatsapp"  class="<%= active==='whatsapp'  ? 'active' : '' %>">Conectar WhatsApp</a>
      <a href="/mensagens" class="<%= active==='mensagens' ? 'active' : '' %>">Mensagens</a>
      <a href="/config"    class="<%= active==='config'    ? 'active' : '' %>">Configurações</a>
      <a href="/rastreios" class="<%= active==='rastreios' ? 'active' : '' %>">Rastreios</a>
      <a href="/logs"      class="<%= active==='logs'      ? 'active' : '' %>">Logs de envio</a>
    </nav>
    <div class="spacer"></div>
    <form method="post" action="/logout">
      <button class="btn-ghost btn-sm" style="width:100%">Sair</button>
    </form>
  </aside>
  <main class="main">
