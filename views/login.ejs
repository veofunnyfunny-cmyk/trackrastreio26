<%- include('partials/head', { title: 'Entrar - Rastreio' }) %>
<div class="auth-split">
  <%- include('partials/auth_hero') %>
  <div class="auth-form-side">
    <div class="form-inner">
      <h2>Entrar na sua conta</h2>
      <p class="sub">Use seu e-mail e senha para acessar o painel.</p>
      <% if (erro) { %><div class="alert err" style="margin-top:16px"><%= erro %></div><% } %>
      <form method="post" action="/login" style="margin-top:14px">
        <label>E-mail</label>
        <input type="email" name="email" value="<%= dados.email || '' %>" required autofocus>
        <label>Senha</label>
        <input type="password" name="password" required>
        <button type="submit" style="width:100%; margin-top:22px">Continuar →</button>
      </form>
      <p class="muted-link">Não tem conta? <a href="/register">Cadastre-se</a></p>
    </div>
    <img class="mobile-hero" src="/static/mobile.png" alt="Track Rastreio — você cuida das vendas, a gente cuida da entrega">
  </div>
</div>
</body></html>
