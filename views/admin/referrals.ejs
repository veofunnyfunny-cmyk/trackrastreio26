<%- include('../partials/head', { title: 'Admin - Indicações' }) %>
<%- include('../partials/shell', { active: 'indicacoes' }) %>

<div class="topbar"><div><h1>Programa de Indicação</h1><p class="sub">Crie links de indicação e defina a % de comissão sobre os depósitos.</p></div></div>

<% if (salvo) { %><div class="alert ok">Salvo!</div><% } %>

<div class="card">
  <h2 style="margin-top:0">Novo indicador</h2>
  <form method="post" action="/admin/indicacoes/criar" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
    <div style="flex:2; min-width:180px"><label>Nome (parceiro/gateway)</label><input type="text" name="name" placeholder="Ex.: Kirvano, João Parceiro..." required></div>
    <div style="flex:1; min-width:110px"><label>Comissão (%)</label><input type="number" name="percent" value="10" min="0" max="100" step="0.5" required></div>
    <button>Criar link</button>
  </form>
</div>

<div class="card">
  <% if (refs.length === 0) { %>
    <p class="sub">Nenhum indicador ainda. Crie o primeiro acima.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Nome</th><th>Link</th><th>%</th><th>Cadastros</th><th>Depositado</th><th>Comissão</th><th></th></tr></thead>
      <tbody>
        <% refs.forEach(r => { %>
          <tr>
            <td><b><%= r.name %></b></td>
            <td>
              <div class="codebox" style="padding:6px 8px; font-size:11px">
                <span id="lk<%= r.id %>"><%= base %>/r/<%= r.code %></span>
                <button type="button" class="btn-ghost btn-sm" onclick="cp('lk<%= r.id %>',this)">Copiar</button>
              </div>
            </td>
            <td>
              <form method="post" action="/admin/indicacoes/<%= r.id %>/percent" style="display:flex; gap:4px; align-items:center">
                <input type="number" name="percent" value="<%= r.percent %>" min="0" max="100" step="0.5" style="width:64px; padding:5px">
                <button class="btn-sm">OK</button>
              </form>
            </td>
            <td><%= r.signups %></td>
            <td><%= billing.formatBRL(r.total_dep) %></td>
            <td class="money-in"><%= billing.formatBRL(r.total_com) %></td>
            <td style="white-space:nowrap">
              <a class="btn btn-sm btn-ghost" href="/admin/indicacoes/<%= r.id %>">Ver</a>
              <form method="post" action="/admin/indicacoes/<%= r.id %>/remover" style="display:inline" onsubmit="return confirm('Excluir este indicador? Os cadastros dele continuam, só para de gerar comissão.')">
                <button class="btn-sm btn-ghost" style="color:var(--danger)">×</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
  function cp(id, btn) {
    navigator.clipboard.writeText(document.getElementById(id).innerText).then(() => {
      var t = btn.innerText; btn.innerText = 'Copiado!'; setTimeout(() => btn.innerText = t, 1200);
    });
  }
</script>

<%- include('../partials/shell_end') %>
