<%- include('../partials/head', { title: 'Rastrear pedido' }) %>
<div class="center-wrap">
  <div class="center-card card">
    <h1>📦 Rastrear pedido</h1>
    <p class="sub">Digite seu código de rastreio</p>
    <% if (erro) { %><div class="alert err"><%= erro %></div><% } %>
    <form method="get" action="/rastreio">
      <input type="text" name="code" placeholder="Ex.: RS-ABC123-4567" required autofocus
             style="text-align:center; text-transform:uppercase; letter-spacing:1px">
      <button type="submit" style="width:100%; margin-top:16px">Rastrear</button>
    </form>
  </div>
</div>
</body></html>
