<%- include('../partials/head', { title: 'Rastreio ' + tracking.code }) %>
<div class="track-page">

  <% if (preview !== null) { %>
    <div class="alert warn" style="margin-bottom:16px">
      🔧 <b>Modo de teste</b> — pré-visualizando a jornada. Pule para o dia:
      <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap">
        <% [0,1,2,4,6,8,9,10].forEach(d => { %>
          <a class="btn btn-sm <%= String(d)===preview ? '' : 'btn-ghost' %>" href="?dia=<%= d %>">Dia <%= d %></a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <div class="track-head">
    <span class="track-store"><span class="logo-mark">📦</span><%= loja || 'Rastreamento' %></span>
  </div>

  <div class="track-card">
    <div class="track-hero">
      <div class="label">Código de rastreio</div>
      <div class="track-code"><%= tracking.code %></div>
      <span class="status-pill"><span class="dot"></span><%= jornada.statusAtual %></span>
      <% if (tracking.customer_name) { %>
        <div class="track-recipient">Destinatário: <b><%= tracking.customer_name %></b></div>
      <% } %>
      <% if (!jornada.entregue) { %>
        <div class="track-recipient">Previsão de entrega: <b>até <%= jornada.previsao %></b></div>
      <% } %>
    </div>

    <div class="track-body">
      <h3>Histórico de movimentação</h3>
      <ul class="timeline">
        <% jornada.eventos.forEach((e, i) => { %>
          <li class="<%= i === 0 ? 'current' : '' %>">
            <div class="t-status"><%= e.status %></div>
            <% if (e.description) { %><div class="t-desc"><%= e.description %></div><% } %>
            <div class="t-when"><%= e.when %></div>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="track-footer">
    <a href="/rastreio">Rastrear outro código</a>
  </div>
</div>
</body></html>
